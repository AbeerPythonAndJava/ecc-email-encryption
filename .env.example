# Copy to .env and fill in. NEVER commit the real .env file.
# Gmail: enable 2-Step Verification, then create an App Password:
#   https://myaccount.google.com/apppasswords

ECC_MAIL_USERNAME=you@gmail.com
ECC_MAIL_PASSWORD=your-16-char-app-password
ECC_MAIL_SMTP_HOST=smtp.gmail.com
ECC_MAIL_SMTP_PORT=587
ECC_MAIL_IMAP_HOST=imap.gmail.com
ECC_MAIL_IMAP_PORT=993
